# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional. Leave empty to use the default model (claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Optional. Set to on to let the planner search live flight prices on Kiwi.com.
LIVE_FLIGHT_SEARCH=
